# .lcovrc
geninfo_options = --no-external

lcov_options = --rc lcov_branch_coverage=1

lcov_output_dir = /home/frr/frr/tests/gtest/coverage

genhtml_output_dir = /home/frr/frr/tests/gtest/coverage/html

lcov_filter=*/home/frr/frr/usr/*
lcov_filter=*/home/frr/frr/lib/*

lcov_filter=*/home/frr/frr/zebra/connected.c
lcov_filter=*/home/frr/frr/zebra/debug*
lcov_filter=*/home/frr/frr/zebra/zebra_evpn*
lcov_filter=*/home/frr/frr/zebra/if_*
lcov_filter=*/home/frr/frr/zebra/ird_*
lcov_filter=*/home/frr/frr/zebra/ip_*
lcov_filter=*/home/frr/frr/zebra/label_*
lcov_filter=*/home/frr/frr/zebra/zebra_m*

lcov_filter_function=zebra_srv6_policy_validate
lcov_filter_function=zebra_sr_policy_deactivate
